# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional Stripe Secret Key (sk_test_...) for live Stripe payment intents.
# If not supplied, the backend operates in Stripe Sandbox / Test Simulation mode with real test card processing.
STRIPE_SECRET_KEY=""

# JWT_SECRET: Secret for signing customer/admin session tokens
JWT_SECRET="aura_commerce_super_secret_jwt_key_2026"

# ==============================================================================
# PRODUCTION SMS PROVIDER CREDENTIALS FOR PHONE OTP VERIFICATION (+91)
# Configure AT LEAST ONE of the following real SMS providers to dispatch OTPs:
# ==============================================================================

# Option 1: Twilio SMS (Global & India)
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Optional Twilio Messaging Service SID (if using Messaging Services instead of a phone number)
TWILIO_MESSAGING_SERVICE_SID=""

# Option 2: 2Factor.in (Specialized for Indian mobile numbers & DLTT templates)
# Get credentials from: https://2factor.in
TWO_FACTOR_API_KEY=""

# Option 3: MSG91 (Leading Indian SMS & OTP gateway)
# Get credentials from: https://msg91.com
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="AURAMS"

# Option 4: Fast2SMS (Popular Indian OTP provider with instant activation)
# Get credentials from: https://fast2sms.com
FAST2SMS_API_KEY=""

# Option 5: Generic REST SMS Gateway / Webhook
# POST request sent with JSON { to, national, message, otp }
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
